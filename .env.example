# Token entregue pelo @BotFather. NUNCA comite o valor real.
BOT_TOKEN=

# Seu chat_id no Telegram. Deixe vazio no primeiro boot: o bot loga o id de
# quem mandar mensagem, com aviso de acesso negado. Copie de la e preencha aqui.
OWNER_CHAT_ID=

# Caminho do banco SQLite dentro do container.
DB_PATH=/data/caderneta.db

# Fuso usado para "hoje", "ontem" e agrupamento por mes.
TZ=America/Sao_Paulo

# Porta do endpoint de health (/healthz e /readyz).
HEALTH_PORT=8080

LOG_LEVEL=INFO
