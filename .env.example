# Token handed out by @BotFather. NEVER commit the real value.
BOT_TOKEN=

# Your Telegram chat_id. Leave it empty on the first boot: the bot logs the id
# of whoever messages it, with an access-denied warning. Copy it from there.
OWNER_CHAT_ID=

# Path of the SQLite database inside the container.
DB_PATH=/data/caderneta.db

# Timezone used for "hoje", "ontem" and monthly grouping.
TZ=America/Sao_Paulo

# Port of the health endpoint (/healthz and /readyz).
HEALTH_PORT=8080

LOG_LEVEL=INFO
